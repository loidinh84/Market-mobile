# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

# Godot & C# text files (luôn giữ LF để tránh diff ảo giữa Windows / macOS / Linux)
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.cfg text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.csv text eol=lf
*.svg text eol=lf
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Git LFS - Ảnh / Texture / File thiết kế
